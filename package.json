{
    "name": "lgtv2",
    "version": "2.0.0",
    "description": "Simple module to remote control LG WebOS smart TVs",
    "type": "module",
    "main": "index.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "pairing.json",
        "examples"
    ],
    "engines": {
        "node": "^20.19.0 || ^22.12.0 || >=24"
    },
    "scripts": {
        "test": "node --test && npm run test:types",
        "test:types": "tsc -p types-test/tsconfig.json",
        "lint": "eslint . && prettier --check .",
        "lintfix": "eslint --fix . && prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hobbyquaker/lgtv2.git"
    },
    "keywords": [
        "tv",
        "smarttv",
        "webos",
        "remote",
        "control"
    ],
    "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://github.com/hobbyquaker)",
    "contributors": [
        "forty2 https://github.com/forty2",
        "Marcin https://github.com/merdok",
        "Erik Montnemery https://github.com/emontnemery"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hobbyquaker/lgtv2/issues"
    },
    "homepage": "https://github.com/hobbyquaker/lgtv2",
    "dependencies": {
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/node": "^24.0.0",
        "@types/ws": "^8.18.0",
        "eslint": "^10.0.0",
        "globals": "^17.0.0",
        "prettier": "^3.9.0",
        "typescript": "^5.9.0"
    }
}
